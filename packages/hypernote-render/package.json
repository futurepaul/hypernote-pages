{
  "name": "@futurepaul/hypernote",
  "version": "0.1.0",
  "description": "Parse, validate, and render Hypernote pages (.hnmd)",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "hypernote": "src/cli.ts"
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "dev": "bun --hot src/serve.ts",
    "check": "bun src/cli.ts check",
    "serve": "bun src/cli.ts serve",
    "test": "bun test tests/check.test.ts",
    "test:e2e": "bunx playwright test",
    "test:all": "bun test tests/check.test.ts && bunx playwright test"
  },
  "dependencies": {
    "applesauce-loaders": "^5.1.0",
    "nostr-idb": "^4.0.1",
    "nostr-tools": "^2.17.2",
    "yaml": "^2.8.1",
    "zig-mdx": "^0.2.8"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "playwright": "^1.52.0"
  },
  "peerDependencies": {
    "applesauce-core": "^5.1.0",
    "applesauce-react": "^5.1.0",
    "applesauce-relay": "^5.1.0",
    "applesauce-signers": "^5.1.0",
    "react": "^19",
    "react-dom": "^19",
    "rxjs": "^7.8.2"
  }
}
